  "typeMapping": {
    "oldBankingModel": {
      "Debit": {
        "meaning": "Money OUT",
        "typically_maps_to": ["Expense", "Asset decrease", "Liability payment"]
      },
      "Credit": {
        "meaning": "Money IN",
        "typically_maps_to": ["Income", "Asset increase", "Liability addition"]
      }
    },
    "newAccountingModel": {
      "Income": {
        "meaning": "Money coming in",
        "paymentMethods": ["Salary", "Freelance", "Investment", "Bonus", "Refund", "Other"],
        "icon": "TrendingUp",
        "color": "success"
      },
      "Expense": {
        "meaning": "Money going out",
        "paymentMethods": ["Credit Card", "Debit Card", "Cash", "Bank Transfer", "UPI", "Cheque", "Other"],
        "icon": "TrendingDown",
        "color": "destructive"
      },
      "Asset": {
        "meaning": "Resource increase",
        "paymentMethods": ["Cash Deposit", "Bank Transfer", "Investment Purchase", "Other"],
        "icon": "PiggyBank",
        "color": "blue-500"
      },
      "Liability": {
        "meaning": "Obligation increase",
        "paymentMethods": ["Loan Disbursement", "Credit Card Opening", "Other"],
        "icon": "AlertTriangle",
        "color": "amber-500"
      }
    }
  },

  "criticalDependencies": [
    "Transaction model changes must be deployed before migration runs",
    "Validation rules must be updated before backend accepts new type",
    "Frontend must be updated to match new backend type enum",
    "Migration must run after both backend changes are live",
    "Old data must be preserved in bankingType for rollback"
  ],

  "riskFactors": [
    {
      "risk": "Existing Debit/Credit transactions lose meaning after change",
      "mitigation": "Store original values in bankingType field, always show both for period"
    },
    {
      "risk": "Frontend and backend types get out of sync",
      "mitigation": "Use same enum from constants file in both backends"
    },
    {
      "risk": "Category type and transaction type mismatch",
      "mitigation": "Add validation to prevent selecting category with different type"
    },
    {
      "risk": "Payment method not valid for selected type",
      "mitigation": "Filter dropdown to only show valid methods per type"
    },
    {
      "risk": "Reports/analytics break if querying old type field",
      "mitigation": "Update all queries to use new type field after migration"
    }
  ],

  "rollbackProcedure": {
    "immediate_if_issues": [
      "Revert frontend to show old Debit/Credit types",
      "Keep new type field optional in model",
      "Queries can fall back to reading bankingType"
    ],
    "data_is_safe_because": [
      "Original Debit/Credit values stored in bankingType",
      "No data deletion, only additions",
      "Migration is reversible by running inverse script"
    ],
    "recovery_steps": [
      "1. Stop accepting new type values",
      "2. Switch frontend back to old type dropdown",
      "3. Update queries to read bankingType if type is missing",
      "4. Investigate root cause",
      "5. Fix and redeploy"
    ]
  }
}
